# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=ai_tech_articles
DATABASE_URL=postgresql+psycopg://postgres:123456@127.0.0.1:5432/ai_tech_articles

# GLM-4.6
GLM_API_KEY=请填写智谱开放平台_API_Key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6
GLM_TITLE_MODEL=glm-4-flash-250414
GLM_EXPERT_MODEL=glm-4.6
GLM_WRITER_MODEL=glm-4.6
GLM_REVIEWER_MODEL=glm-4-flash-250414
GLM_DIRECTOR_MODEL=glm-4.6
GLM_TEMPERATURE=0.5
GLM_MAX_TOKENS=50000
GLM_ENABLE_THINKING=false
GLM_TIMEOUT_SECONDS=180
GLM_SEARCH_ENGINE=search_std
GLM_SEARCH_COUNT=10
# 如果本机使用代理软件，请填写 HTTP 代理；不需要代理时留空
GLM_PROXY_URL=
GLM_TOKEN_BUDGET=0
# 多模型方案由设置页面自动维护；请勿手动填写 API Key JSON
MODEL_PROFILES_JSON=
ACTIVE_MODEL_PROFILE_ID=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=
WECHAT_API_BASE_URL=https://api.weixin.qq.com

# Application
APP_NAME=技术文章工坊
APP_ENV=development
APP_BASE_PATH=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
